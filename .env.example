RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_DATA_DIR=.data/relay
# Generate separate values with npm run keys. Never commit the real .env.
PHONE_TOKEN=replace-with-at-least-32-random-characters
BRIDGE_TOKEN=replace-with-a-different-32-character-secret
# Required when accessed through HTTPS reverse proxy (no trailing slash).
# PUBLIC_ORIGIN=https://relay.example.com:8443
# Optional encrypted TURN fallback. Configure these on the relay server only.
# TURN_URLS=turn:relay.example.com:3478?transport=tcp,turn:relay.example.com:3478?transport=udp
# TURN_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
