{
  "name": "agent-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run coding agents locally; browse and control sessions through your own relay.",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "relay": "node --env-file-if-exists=.env --import tsx src/relay/main.ts",
    "bridge": "node --env-file-if-exists=.env --import tsx src/bridge/main.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "keys": "node scripts/keys.mjs",
    "setup": "node scripts/setup.mjs",
    "smoke:live": "node --import tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
