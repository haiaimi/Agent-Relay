{
  "name": "agent-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run coding agents locally; browse and control sessions through your own relay.",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "relay": "node --env-file-if-exists=.env --import tsx src/relay/main.ts",
    "bridge": "node --env-file-if-exists=.env --import tsx src/bridge/main.ts",
    "launcher": "node --env-file-if-exists=.env --import tsx src/bridge/launcher-main.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "keys": "node scripts/keys.mjs",
    "setup": "node scripts/setup.mjs",
    "assets:setup": "node scripts/asset-pipeline.mjs setup",
    "assets:doctor": "node scripts/asset-pipeline.mjs doctor",
    "assets:demo": "node scripts/asset-pipeline.mjs demo",
    "assets:run": "node scripts/asset-pipeline.mjs run",
    "assets:project": "node scripts/asset-pipeline.mjs project",
    "questions:install": "node scripts/install-question-hook.mjs",
    "smoke:live": "node --import tsx scripts/smoke-live.ts",
    "smoke:studio": "node --import tsx scripts/smoke-studio.ts",
    "desktop": "npm run setup && npm run build && electron desktop/main.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@mermaid-js/tiny": "12.3.0",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "sharp": "0.35.5",
    "werift": "0.26.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "electron": "45.2.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
