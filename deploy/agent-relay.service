[Unit]
Description=Agent Relay (message relay only; no agent execution)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/agent-relay/current
EnvironmentFile=/etc/agent-relay.env
ExecStart=/opt/agent-relay-runtime/bin/node /opt/agent-relay/current/dist/relay/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-relay
UMask=0077

[Install]
WantedBy=multi-user.target
